      "Bash(python3 *)",
      "Bash(git log *)",
      "Bash(git log)",
      "Bash(git show *)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git blame *)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(ls *)",
      "Bash(ls)",
      "Bash(pwd)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(find *)",
      "Bash(grep *)",
      "Bash(mkdir *)",
      "Bash(mv *)",
      "Bash(cp *)",
      "Bash(touch *)",
      "Bash(echo *)",
      "PowerShell(python *)",
      "PowerShell(python3 *)",
      "PowerShell(git log *)",
      "PowerShell(git log)",
      "PowerShell(git show *)",
      "PowerShell(git diff *)",
      "PowerShell(git diff)",
      "PowerShell(git blame *)",
      "PowerShell(git status *)",
      "PowerShell(git status)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-ChildItem)",
      "PowerShell(ls *)",
      "PowerShell(ls)",
      "PowerShell(dir *)",
      "PowerShell(dir)",
      "PowerShell(Get-Content *)",
      "PowerShell(cat *)",
      "PowerShell(Get-Location)",
      "PowerShell(Test-Path *)",
      "PowerShell(New-Item *)",
      "PowerShell(mkdir *)",
      "PowerShell(Move-Item *)",
      "PowerShell(mv *)",
      "PowerShell(Copy-Item *)",
      "PowerShell(cp *)",
      "PowerShell(Rename-Item *)"
    ]
